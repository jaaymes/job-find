# String de conexão do Postgres (ex.: Neon). Obrigatória em produção.
DATABASE_URL=

# Segredo que autentica as chamadas do cron (Authorization: Bearer ...) às rotas de ingestão.
CRON_SECRET=

# Token do GitHub (somente leitura) para aumentar o limite de requisições das fontes que usam a API do GitHub.
GITHUB_TOKEN=

# Chave de API do Himalayas, usada pelo conector dessa fonte de vagas.
HIMALAYAS_API_KEY=
