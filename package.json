{
  "name": "job-find",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "if [ \"$VERCEL_ENV\" = production ]; then pnpm db:migrate; fi && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project 'unit*'",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "eval:ai": "tsx scripts/eval-ai.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/mistral": "^4.0.89",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@ai-sdk/provider": "^4.0.39",
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.108.2",
    "@vercel/functions": "^3.11.3",
    "ai": "^7.0.179",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.5.0",
    "drizzle-orm": "^0.45.4",
    "franc-min": "^6.2.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.2",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "undici": "7.30.2",
    "unpdf": "^2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "client-only": "^0.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.6.0"
}
